{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../../sdks/typescript/node_modules/@types"
    ],
    "paths": {
      "criogenai": [
        "../../../sdks/typescript/dist/index.d.ts"
      ],
      "zod": [
        "../../../sdks/typescript/node_modules/zod/index.d.ts"
      ],
      "criogenai/web": [
        "../../../sdks/typescript/dist/index.d.ts"
      ],
      "@/lib/agent": [
        "./deploy_agent.ts"
      ],
      "@/lib/support_agent": [
        "./support_agent.ts"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "*.ts"
  ]
}
