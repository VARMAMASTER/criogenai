# Template used by scripts/test-package.sh. The script copies this project to
# a temporary directory, fills in the paths of the unpacked packages
# and runs it. Not a workspace member.
[package]
name = "agentbuild-package-test"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
agentbuild-core = { path = "@AGENTBUILD_CORE_DIR@" }
agentbuild-providers = { path = "@AGENTBUILD_PROVIDERS_DIR@" }
serde_json = "1"
tokio = { version = "1.40", features = ["macros", "rt-multi-thread", "time"] }

# Stand-alone: never part of the AgentBuild workspace.
[workspace]
