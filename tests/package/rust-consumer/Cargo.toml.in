# Template used by scripts/test-package.sh. The script copies this project to
# a temporary directory, writes Cargo.toml with the path of the unpacked
# package, and runs it. Not a workspace member.
[package]
name = "agentbuild-package-test"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
agentbuild-core = { path = "@PACKAGE_DIR@" }
serde_json = "1"
tokio = { version = "1.40", features = ["macros", "rt-multi-thread", "time"] }

# Stand-alone: never part of the AgentBuild workspace.
[workspace]
