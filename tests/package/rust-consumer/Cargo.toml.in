# Template used by scripts/test-package.sh. The script copies this project to
# a temporary directory, fills in the paths of the unpacked packages
# and runs it. Not a workspace member.
[package]
name = "criogenai-package-test"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
criogenai-core = { path = "@CRIOGENAI_CORE_DIR@" }
criogenai-providers = { path = "@CRIOGENAI_PROVIDERS_DIR@" }
criogenai-storage = { path = "@CRIOGENAI_STORAGE_DIR@", features = ["sqlite", "postgres", "encryption"] }
criogenai-agent = { path = "@CRIOGENAI_AGENT_DIR@" }
criogenai-telemetry = { path = "@CRIOGENAI_TELEMETRY_DIR@" }
criogenai-gateway = { path = "@CRIOGENAI_GATEWAY_DIR@" }
axum = { version = "0.8", default-features = false, features = ["http1", "tokio"] }
serde_json = "1"
tokio = { version = "1.40", features = ["macros", "rt-multi-thread", "time", "net"] }

# The packaged crates depend on each other through crates.io versions, which
# are not published: use the unpacked packages instead.
[patch.crates-io]
criogenai-rt = { path = "@CRIOGENAI_RT_DIR@" }
criogenai-core = { path = "@CRIOGENAI_CORE_DIR@" }
criogenai-providers = { path = "@CRIOGENAI_PROVIDERS_DIR@" }
criogenai-storage = { path = "@CRIOGENAI_STORAGE_DIR@" }

# Stand-alone: never part of the CriogenAI workspace.
[workspace]
