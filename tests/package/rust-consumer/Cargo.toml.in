# Template used by scripts/test-package.sh. The script copies this project to
# a temporary directory, fills in the paths of the unpacked packages
# and runs it. Not a workspace member.
[package]
name = "agentbuild-package-test"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
agentbuild-core = { path = "@AGENTBUILD_CORE_DIR@" }
agentbuild-providers = { path = "@AGENTBUILD_PROVIDERS_DIR@" }
agentbuild-storage = { path = "@AGENTBUILD_STORAGE_DIR@", features = ["sqlite", "postgres", "encryption"] }
agentbuild-agent = { path = "@AGENTBUILD_AGENT_DIR@" }
agentbuild-telemetry = { path = "@AGENTBUILD_TELEMETRY_DIR@" }
serde_json = "1"
tokio = { version = "1.40", features = ["macros", "rt-multi-thread", "time"] }

# The packaged crates depend on each other through crates.io versions, which
# are not published: use the unpacked packages instead.
[patch.crates-io]
agentbuild-core = { path = "@AGENTBUILD_CORE_DIR@" }
agentbuild-providers = { path = "@AGENTBUILD_PROVIDERS_DIR@" }
agentbuild-storage = { path = "@AGENTBUILD_STORAGE_DIR@" }

# Stand-alone: never part of the AgentBuild workspace.
[workspace]
