{
  "name": "criogen",
  "version": "0.1.4",
  "description": "The fast AI agent framework for TypeScript and Node.js, a LangChain and LangGraph alternative on a Rust engine: tool calling, multi-agent workflows, human approval, durable threads, memory and an LLM gateway",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "ai",
    "ai-agents",
    "agent",
    "agent-framework",
    "llm",
    "llm-agents",
    "multi-agent",
    "agentic",
    "agent-orchestration",
    "workflow",
    "tool-calling",
    "function-calling",
    "langchain-alternative",
    "langgraph-alternative",
    "openai",
    "anthropic",
    "gemini",
    "rust",
    "typescript",
    "nextjs"
  ],
  "homepage": "https://criogen.vercel.app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist-web/types/browser/index.d.ts",
      "default": "./dist-web/criogen.js"
    },
    "./web/criogen_bg.wasm": "./dist-web/criogen_bg.wasm",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-web",
    "native/criogen.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "cargo build --release && node scripts/copy-native.js",
    "build": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test test/agent.test.js test/function-model.test.js test/workflow.test.js test/gateway.test.js test/patterns.test.js test/web.test.js test/env.test.js test/kaggle.test.js test/ready.test.js test/usage.test.js test/redact.test.js test/version.test.js test/providers.test.js test/mcp.test.js",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:browser": "node test/browser/run.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.7.2",
    "zod": "4.6.7"
  }
}
