# Types of the native module (sdks/python/src/lib.rs). Internal: use the
# public API in criogen/__init__.py.

import asyncio
from typing import Any, Awaitable, Callable, List, Optional, Tuple

__version__: str

class NativeStorage:
    def __init__(self, spec: str) -> None: ...
    def op(self, event_loop: asyncio.AbstractEventLoop, op: str, payload: str) -> Awaitable[Any]: ...
    def close(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[None]: ...

class NativeMcp:
    def __init__(self) -> None: ...
    def connect(self, event_loop: asyncio.AbstractEventLoop, spec: str) -> Awaitable[dict]: ...
    def refresh(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[dict]: ...
    def call(self, event_loop: asyncio.AbstractEventLoop, name: str, args: str) -> Awaitable[dict]: ...
    def close(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[None]: ...

class NativeStream:
    def next(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[Optional[dict]]: ...
    def finish(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[dict]: ...
    def cancel(self) -> None: ...

class NativeAgent:
    def __init__(
        self,
        config: str,
        tools: List[Tuple[Callable[[str, str], Any], bool]],
        storage: Optional[NativeStorage] = None,
        agent_tools: List[Tuple[str, str, "NativeAgent"]] = ...,
        telemetry: Optional["NativeTelemetry"] = None,
        hooks: List[Tuple[str, Callable[[str, str], Any], List[str]]] = ...,
        mcp: List[Tuple[NativeMcp, Optional[List[str]]]] = ...,
    ) -> None: ...
    def run(self, event_loop: asyncio.AbstractEventLoop, payload: str) -> Awaitable[dict]: ...
    def thread(self, event_loop: asyncio.AbstractEventLoop, op: str, payload: str) -> Awaitable[Any]: ...
    def stream(self, event_loop: asyncio.AbstractEventLoop, op: str, payload: str) -> NativeStream: ...

class NativeWorkflow:
    def __init__(
        self,
        config: str,
        nodes: List[Tuple[str, Callable[[str, str], Any], bool]],
        routers: List[Tuple[str, Callable[[str, str], str]]],
        agents: List[Tuple[str, NativeAgent]],
        storage: Optional[NativeStorage] = None,
    ) -> None: ...
    def run(self, event_loop: asyncio.AbstractEventLoop, payload: str) -> Awaitable[dict]: ...
    def resume(self, event_loop: asyncio.AbstractEventLoop, payload: str) -> Awaitable[dict]: ...
    def thread(self, event_loop: asyncio.AbstractEventLoop, op: str, payload: str) -> Awaitable[Any]: ...

class NativeGateway:
    def __init__(self, config: str) -> None: ...
    def chat(self, event_loop: asyncio.AbstractEventLoop, payload: str) -> Awaitable[Any]: ...
    def stream(self, payload: str) -> "NativeChatStream": ...
    def embed(self, event_loop: asyncio.AbstractEventLoop, payload: str) -> Awaitable[Any]: ...

class NativeChatStream:
    def next(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[Any]: ...
    def reply(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[Any]: ...
    def cancel(self) -> None: ...

class NativeTelemetry:
    def __init__(self, spec: str) -> None: ...
    def flush(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[None]: ...
    def shutdown(self, event_loop: asyncio.AbstractEventLoop) -> Awaitable[None]: ...
    def stats(self) -> str: ...
